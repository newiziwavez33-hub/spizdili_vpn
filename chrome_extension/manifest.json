{
  "manifest_version": 3,
  "name": "SPIZDILI_VPN — Chrome Extension",
  "version": "1.0.6.1",
  "description": "Автономный быстрый VPN и прокси для Google Chrome с защитой конфиденциальности, AI-оптимизацией и енотом-маскотом",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SPIZDILI_VPN",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "proxy",
    "storage"
  ],
  "host_permissions": [
    "https://api.ipify.org/*",
    "http://ip-api.com/*"
  ]
}
