def main() -> int:
    """Entry point for the privileged helper."""
    syslog.openlog("wavez-vpn-helper", syslog.LOG_PID, syslog.LOG_DAEMON)

    if len(sys.argv) < 2:
        output_error(
            f"Usage: {sys.argv[0]} <command> [args...]\n"
            f"Commands: {', '.join(COMMANDS.keys())}"
        )
        return 1

    command = sys.argv[1]
    args = sys.argv[2:]

    handler = COMMANDS.get(command)
    if handler is None:
        output_error(f"Unknown command: {command}")
        return 1

    log_info(f"Executing command: {command} {' '.join(args)}")

    try:
        handler(args)
    except Exception as exc:
        output_error(f"Unexpected error: {exc}")
        syslog.syslog(syslog.LOG_ERR, f"vpn-helper exception: {exc}")
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
