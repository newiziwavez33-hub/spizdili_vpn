# Command: dns-restore
# ---------------------------------------------------------------------------


def cmd_dns_restore(args: list[str]) -> None:
    """Restore DNS settings for a WireGuard interface."""
    if len(args) < 1:
        output_error("Usage: dns-restore <interface>")
        return

    interface = derive_interface_name(args[0])
    if not validate_interface(interface):
        output_error(f"Invalid interface: {interface}")
        return

    if not check_binary("resolvectl"):
        if not check_binary("systemd-resolve"):
            output_error("Neither resolvectl nor systemd-resolve found")
            return
        resolve_cmd = "systemd-resolve"
    else:
        resolve_cmd = "resolvectl"

    log_info(f"Restoring DNS on {interface}")

    try:
        r = run_cmd([resolve_cmd, "revert", interface])
        if r.returncode != 0:
            # Interface might already be gone, not an error
            log_info(f"DNS revert note: {r.stderr.strip()}")
        output_success()
    except subprocess.TimeoutExpired:
        output_error("DNS restore timed out")
    except FileNotFoundError:
        output_error(f"{resolve_cmd} not found")


