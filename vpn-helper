def cmd_test_endpoint(args: list[str]) -> None:
    """Diagnostic check for a remote endpoint (ping, UDP, DNS)."""
    if len(args) < 1:
        output_error("Usage: test-endpoint <host_or_ip> [port]")
        return

    host = args[0].strip("[]")
    port = 51820
    if len(args) >= 2:
        try:
            port = int(args[1])
        except ValueError:
            pass

    resolved_ip = ""
    try:
        addrinfo = socket.getaddrinfo(host, port, socket.AF_INET)
        if addrinfo:
            resolved_ip = addrinfo[0][4][0]
    except Exception:
        if validate_ip(host):
            resolved_ip = host

    target = resolved_ip or host
    ping_ms = None
    try:
        r = run_cmd(["ping", "-c", "2", "-W", "2", target], timeout=5)
        if r.returncode == 0:
            m = re.search(r"rtt min/avg/max/mdev = [\d.]+/([\d.]+)/", r.stdout)
            if not m:
                m = re.search(r"round-trip min/avg/max(?:/\w+)? = [\d.]+/([\d.]+)/", r.stdout)
            if m:
                ping_ms = round(float(m.group(1)), 1)
    except Exception:
        pass

    output_success(
        host=host,
        resolved_ip=resolved_ip,
        port=port,
        ping_ms=ping_ms,
        reachable=bool(resolved_ip and ping_ms is not None),
    )


def cmd_start_tun(args: list[str]) -> None:
    """Start hev-socks5-tunnel and configure system-wide kernel routing."""
    socks_port = int(args[0]) if args else 20808
    tun_name = args[1] if len(args) > 1 else "tun_wavez"
    fwmark = args[2] if len(args) > 2 else "51820"
    table = args[3] if len(args) > 3 else "51820"

    # 1. Clean any existing tun
    cmd_stop_tun([tun_name, fwmark, table], silent=True)

    # 2. Find hev-socks5-tunnel binary
    candidates = [
        "/usr/local/bin/hev-socks5-tunnel",
        "/opt/incy/lib/app/resources/bin/hev-socks5-tunnel",
        str(Path(__file__).resolve().parent / "bin" / "hev-socks5-tunnel"),
    ]
    hev_bin = None
    for c in candidates:
        if os.path.isfile(c) and os.access(c, os.X_OK):
            hev_bin = c
            break

    if not hev_bin:
        output_error("hev-socks5-tunnel binary not found")
        return

    # 3. Create config
    cfg_path = Path("/tmp/wavez_tun.yml")
    cfg_content = f"""tunnel:
  name: {tun_name}
  mtu: 1500
  multi-queue: false
  ipv4: 198.18.0.1
  ipv6: 'fc00::1'

socks5:
  port: {socks_port}
  address: 127.0.0.1
  udp: 'tcp'
  mark: {fwmark}
"""
    cfg_path.write_text(cfg_content, encoding="utf-8")

    # 4. Start hev-socks5-tunnel detached
    pid_file = Path("/tmp/wavez_tun.pid")
    try:
        proc = subprocess.Popen(
            [hev_bin, str(cfg_path)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        pid_file.write_text(str(proc.pid))
    except Exception as exc:
        output_error(f"Failed to start hev-socks5-tunnel: {exc}")
        return

    # 5. Wait for TUN device to appear in /sys/class/net
    tun_ready = False
    for _ in range(30):
        if Path(f"/sys/class/net/{tun_name}").exists():
            tun_ready = True
            break
        time.sleep(0.1)

    if not tun_ready:
        output_error(f"TUN interface {tun_name} failed to initialize")
        return

    # 6. Configure interface IP and routes
    run_cmd(["ip", "link", "set", "dev", tun_name, "up"])
    run_cmd(["ip", "addr", "add", "198.18.0.1/16", "dev", tun_name])

    # Clean old routes
    run_cmd(["ip", "rule", "del", "not", "fwmark", fwmark, "table", table])
    run_cmd(["ip", "route", "del", "default", "dev", tun_name, "table", table])
    run_cmd(["ip", "-6", "rule", "del", "not", "fwmark", fwmark, "table", table])
    run_cmd(["ip", "-6", "route", "del", "default", "dev", tun_name, "table", table])

    # Add default routes through TUN
    run_cmd(["ip", "route", "replace", "default", "dev", tun_name, "table", table])
    run_cmd(["ip", "rule", "add", "not", "fwmark", fwmark, "table", table])
    run_cmd(["ip", "-6", "route", "replace", "default", "dev", tun_name, "table", table])
    run_cmd(["ip", "-6", "rule", "add", "not", "fwmark", fwmark, "table", table])

    # 7. DNS setup via resolvectl
    run_cmd(["resolvectl", "dns", tun_name, "8.8.8.8", "1.1.1.1"])
    run_cmd(["resolvectl", "domain", tun_name, "~."])
    run_cmd(["resolvectl", "flush-caches"])

    output_success(interface=tun_name, pid=proc.pid)


def cmd_stop_tun(args: list[str], silent: bool = False) -> None:
    """Tear down hev-socks5-tunnel and restore routing/DNS."""
    tun_name = args[0] if len(args) > 0 else "tun_wavez"
    fwmark = args[1] if len(args) > 1 else "51820"
    table = args[2] if len(args) > 2 else "51820"

    # 1. Clean routes
    run_cmd(["ip", "rule", "del", "not", "fwmark", fwmark, "table", table])
    run_cmd(["ip", "route", "del", "default", "dev", tun_name, "table", table])
    run_cmd(["ip", "-6", "rule", "del", "not", "fwmark", fwmark, "table", table])
    run_cmd(["ip", "-6", "route", "del", "default", "dev", tun_name, "table", table])

    # 2. Restore DNS
    run_cmd(["resolvectl", "revert", tun_name])
    run_cmd(["resolvectl", "flush-caches"])

    # 3. Kill process
    pid_file = Path("/tmp/wavez_tun.pid")
    if pid_file.is_file():
        try:
            pid = int(pid_file.read_text().strip())
            os.kill(pid, 9)
        except Exception:
            pass
        pid_file.unlink(missing_ok=True)

    run_cmd(["pkill", "-9", "-f", "hev-socks5-tunnel"])

    # 4. Remove interface
    run_cmd(["ip", "link", "del", "dev", tun_name])

    if not silent:
        output_success(interface=tun_name)


def cmd_setup_xray_routes(args: list[str]) -> None:
    """Configure system-wide kernel routing and DNS for Xray TUN interface."""
    tun = args[0] if len(args) > 0 else "tun_wavez"
    fwmark = args[1] if len(args) > 1 else "51820"
    table = args[2] if len(args) > 2 else "51820"

    # Wait up to 3s for TUN device to appear in /sys/class/net
    for _ in range(30):
        if Path(f"/sys/class/net/{tun}").exists():
            break
        time.sleep(0.1)

    # Clean old rules
    run_cmd(["ip", "rule", "del", "not", "fwmark", fwmark, "table", table])
    run_cmd(["ip", "route", "del", "default", "dev", tun, "table", table])
    run_cmd(["ip", "-6", "rule", "del", "not", "fwmark", fwmark, "table", table])
    run_cmd(["ip", "-6", "route", "del", "default", "dev", tun, "table", table])

    # Ensure MTU 1400 to prevent packet fragmentation
    run_cmd(["ip", "link", "set", "dev", tun, "mtu", "1400"])

    # Add default routes through TUN
    run_cmd(["ip", "route", "replace", "default", "dev", tun, "table", table])
    run_cmd(["ip", "rule", "add", "not", "fwmark", fwmark, "table", table])
    run_cmd(["ip", "-6", "route", "replace", "default", "dev", tun, "table", table])
    run_cmd(["ip", "-6", "rule", "add", "not", "fwmark", fwmark, "table", table])

    # Point system DNS to the tunnel resolver
    run_cmd(["resolvectl", "dns", tun, "8.8.8.8", "1.1.1.1"])
    run_cmd(["resolvectl", "domain", tun, "~."])
    run_cmd(["resolvectl", "flush-caches"])

    output_success(interface=tun)


def cmd_cleanup_xray_routes(args: list[str]) -> None:
    """Tear down kernel routing and DNS for Xray TUN interface."""
    tun = args[0] if len(args) > 0 else "tun_wavez"
    fwmark = args[1] if len(args) > 1 else "51820"
    table = args[2] if len(args) > 2 else "51820"

    run_cmd(["ip", "rule", "del", "not", "fwmark", fwmark, "table", table])
    run_cmd(["ip", "route", "del", "default", "dev", tun, "table", table])
    run_cmd(["ip", "-6", "rule", "del", "not", "fwmark", fwmark, "table", table])
    run_cmd(["ip", "-6", "route", "del", "default", "dev", tun, "table", table])

    run_cmd(["resolvectl", "revert", tun])
    run_cmd(["resolvectl", "flush-caches"])

    run_cmd(["ip", "link", "del", "dev", tun])

    output_success(interface=tun)


